# Execute only the built CLI, without a shell. Parse actual JSON with CMake's JSON parser.
function(run_json expected_code)
  execute_process(COMMAND "${APP}" ${ARGN} --json RESULT_VARIABLE code
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "Unexpected exit ${code}: ${output} ${error}")
  endif()
  if(NOT error STREQUAL "")
    message(FATAL_ERROR "JSON command wrote stderr: ${error}")
  endif()
  string(JSON schema GET "${output}" schema_version)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Invalid schema version")
  endif()
  set(result_json "${output}" PARENT_SCOPE)
endfunction()
run_json(0 --version)
string(JSON version GET "${result_json}" application_version)
if(NOT version STREQUAL "1.0.0")
  message(FATAL_ERROR "Invalid application version")
endif()
run_json(0 --help)
string(JSON help TYPE "${result_json}" help)
if(NOT help STREQUAL "STRING")
  message(FATAL_ERROR "Help must be a string")
endif()
run_json(2 device malformed)
string(JSON domain GET "${result_json}" error domain)
if(NOT domain STREQUAL "cli")
  message(FATAL_ERROR "Expected CLI error")
endif()
run_json(2 list --limit -1)
run_json(2 device "ROOT\\TEST\\0000" --limit 100)
run_json(2 --bogus)
if(LIVE)
  run_json(3 device "ROOT\\DDBE_MISSING_7F624BEC_296A_4E39\\0000")
  run_json(0 list --limit 1)
  string(JSON count GET "${result_json}" shown_count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Live list must return one device")
  endif()
  string(JSON id GET "${result_json}" devices 0 instance_id value)
  run_json(0 device "${id}")
  foreach(field hardware_ids compatible_ids)
    string(JSON state GET "${result_json}" result identifiers ${field} availability)
    string(JSON type TYPE "${result_json}" result identifiers ${field} value)
    if(state STREQUAL "available" AND NOT type STREQUAL "ARRAY")
      message(FATAL_ERROR "Available IDs must be arrays")
    elseif(NOT state STREQUAL "available" AND NOT type STREQUAL "NULL")
      message(FATAL_ERROR "Unavailable IDs must be null")
    endif()
  endforeach()
  run_json(0 list --match DDBE_MISSING_7F624BEC_296A_4E39)
  string(JSON matches GET "${result_json}" matched_count)
  if(NOT matches EQUAL 0)
    message(FATAL_ERROR "Empty filter must return no matches")
  endif()
endif()
